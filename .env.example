# Copy this file to .env.local and fill in real values.
# Never commit .env.local (or any file with real secrets) to git.

# =============================================================================
# PUBLIC -- safe to expose to the browser (NEXT_PUBLIC_* vars are bundled
# into client-side JavaScript by Next.js). Do not put secrets here.
# =============================================================================

# Supabase project URL and anon (public) key. Required for auth, and for
# every product/profile/store_connections read the client makes.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# This app's own public base URL, no trailing slash. Used to build the
# Stripe checkout return URLs and the Shopify OAuth redirect URI
# (${NEXT_PUBLIC_SITE_URL}/api/shopify/callback) -- the Shopify redirect URI
# must be allow-listed in the Partner Dashboard to match this exactly.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# =============================================================================
# SERVER-ONLY -- never reference these with NEXT_PUBLIC_, never send them to
# the client, never log them.
# =============================================================================

# Supabase service-role key. Bypasses Row Level Security -- used only in
# trusted server contexts (Stripe/Shopify webhook processing,
# store_connections access). Treat as a master key to the database.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe. Secret key for the server SDK, and the webhook signing secret for
# verifying app/api/stripe/webhook requests.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# OpenAI. Powers /api/analyze, /api/marketing, /api/generate_marketing, and
# /api/ai-search. OPENAI_MODEL is optional and defaults to "gpt-4.1-mini"
# (see lib/openai.ts) if unset.
OPENAI_API_KEY=
OPENAI_MODEL=

# DataForSEO. The only product-search data provider currently wired up
# (lib/services/dataforseoProductSearch.ts) -- pulls Amazon's merchant
# catalog. Without both of these, /api/product-search returns 503 rather
# than fake/empty results. LOCATION/LANGUAGE codes are optional (default to
# 2840 / "en" -- see README for details).
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_LOCATION_CODE=
DATAFORSEO_LANGUAGE_CODE=

# Shopify. Client ID/Secret from the Partner/Dev Dashboard app. Secret is
# also used to verify OAuth callback and webhook HMAC signatures. See the
# README's Shopify section for the exact webhook subscriptions and scopes
# required.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Dedicated 32-byte AES-256-GCM key (base64) used only to encrypt Shopify
# access/refresh tokens at rest. Generate with: openssl rand -base64 32
# Do not reuse any other secret for this. Rotating it makes existing stored
# tokens undecryptable -- there is currently no rotation/migration path.
SHOPIFY_TOKEN_ENCRYPTION_KEY=
